# Installed by start.sh
/.tools/
/.venv/
renderer/node_modules/
app/node_modules/
app/dist-mock/
# Built web UI (videocut setup / start.sh build it from app/)
src/videocut/web/dist/

# Never commit user material (it lives in ~/VideoCut anyway)
/jobs/
/brands/*
!/brands/_example/
*.mov
*.mp4
*.m4a
*.wav

# Local, personal settings
.env
.env.*
!.env.example
/.local/

# OS / tooling
.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# The local app: built from app/ by `videocut setup`, never committed
/src/videocut/web/dist/
/app/node_modules/
/app/dist-mock/
/app/e2e/out/

# Claude Code session worktrees (the repository's .claude/skills/ stays tracked)
/.claude/worktrees/
